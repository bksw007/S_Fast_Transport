rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && profile().data.active == true
        && (
          !profile().data.keys().hasAny(["approvalStatus"])
          || profile().data.approvalStatus == "approved"
        );
    }

    function isMainAdmin() {
      return activeUser() && profile().data.role in ["admin", "dispatcher", "owner"];
    }

    function isSubcontractAdmin() {
      return activeUser() && profile().data.role == "subcontract_admin";
    }

    function job(jobId) {
      return firestore.get(/databases/(default)/documents/today_jobs/$(jobId));
    }

    function sameOrganization(jobId) {
      return activeUser()
        && profile().data.organizationId != null
        && job(jobId).data.organizationId == profile().data.organizationId;
    }

    function isAssignedDriver(jobId) {
      return activeUser() && job(jobId).data.assignedDriverUid == request.auth.uid;
    }

    function isOwnOtherExpense(jobId, uid) {
      return activeUser() && uid == request.auth.uid
        && jobId.matches('other_[a-f0-9-]{36}');
    }

    function isOtherExpenseInOrganization(jobId, uid) {
      return jobId.matches('other_[a-f0-9-]{36}')
        && profile().data.organizationId == userProfile(uid).data.organizationId;
    }

    function isJobCustomer(jobId) {
      return activeUser()
        && profile().data.role == "customer"
        && profile().data.customerId is string
        && profile().data.customerId.size() > 0
        && job(jobId).data.customerId == profile().data.customerId;
    }

    function userProfile(uid) {
      return firestore.get(/databases/(default)/documents/users/$(uid));
    }

    function canReadUserFile(uid) {
      return (signedIn() && request.auth.uid == uid)
        || (activeUser() && (
          isMainAdmin()
        || (
          isSubcontractAdmin()
          && profile().data.organizationId != null
          && userProfile(uid).data.organizationId == profile().data.organizationId
        )));
    }

    function canManageOrganization(orgId) {
      return activeUser()
        && (
          isMainAdmin()
          || (
            isSubcontractAdmin()
            && profile().data.organizationId == orgId
          )
        );
    }

    match /proof_of_delivery/{jobId}/{uid}/{fileName} {
      allow read: if isMainAdmin() || sameOrganization(jobId) || isAssignedDriver(jobId) || isJobCustomer(jobId);
      allow write: if activeUser()
        && uid == request.auth.uid
        && (isMainAdmin() || isSubcontractAdmin() || isAssignedDriver(jobId))
        && (isMainAdmin() || sameOrganization(jobId) || isAssignedDriver(jobId))
        && request.resource.size > 0
        && (
          (
            request.resource.size <= 1 * 1024 * 1024
            && request.resource.contentType.matches("image/.*")
          )
          || (
            request.resource.size <= 10 * 1024 * 1024
            && request.resource.contentType == "application/pdf"
          )
        );
    }

    match /driver_expenses/{jobId}/{uid}/{fileName} {
      allow read: if isMainAdmin()
        || (isSubcontractAdmin() && (isOtherExpenseInOrganization(jobId, uid) || sameOrganization(jobId)))
        || (activeUser() && uid == request.auth.uid && (isOwnOtherExpense(jobId, uid) || isAssignedDriver(jobId)));
      allow create, update: if activeUser()
        && uid == request.auth.uid
        && (isOwnOtherExpense(jobId, uid) || (isAssignedDriver(jobId) && job(jobId).data.status == "completed"))
        && request.resource.size > 0
        && request.resource.size <= 1 * 1024 * 1024
        && request.resource.contentType.matches("image/jpeg|image/png|image/webp");
      // The expense document is deleted before its receipts, so cleanup cannot rely on it.
      allow delete: if activeUser() && uid == request.auth.uid;
    }


    match /user_profiles/{uid}/profile/{fileName} {
      allow read: if canReadUserFile(uid);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size <= 1 * 1024 * 1024
        && request.resource.contentType.matches("image/jpeg|image/png|image/webp");
      allow delete: if activeUser() && request.auth.uid == uid;
    }

    match /user_documents/{uid}/{documentKind}/{fileName} {
      allow read: if canReadUserFile(uid);
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && documentKind in ["id-card-front", "driver-license-front"]
        && request.resource.size > 0
        && (
          (
            request.resource.size <= 1 * 1024 * 1024
            && request.resource.contentType.matches("image/jpeg|image/png|image/webp")
          )
          || (
            request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType == "application/pdf"
          )
        );
      allow delete: if activeUser() && request.auth.uid == uid;
    }

    match /vehicle_files/{orgId}/{vehicleId}/{category}/{fileKind}/{fileName} {
      allow read: if canManageOrganization(orgId);
      allow create, update: if canManageOrganization(orgId)
        && category in ["documents", "images"]
        && (
          (category == "documents" && fileKind in ["compulsoryInsurance", "vehicleInsurance", "cargoInsurance", "other"])
          || (category == "images" && fileKind in ["front", "rear", "right", "left"])
        )
        && request.resource.size > 0
        && (
          (
            request.resource.size <= 1 * 1024 * 1024
            && request.resource.contentType.matches("image/jpeg|image/png|image/webp")
          )
          || (
            category == "documents"
            && request.resource.size <= 5 * 1024 * 1024
            && request.resource.contentType == "application/pdf"
          )
        );
      allow delete: if canManageOrganization(orgId);
    }
  }
}
