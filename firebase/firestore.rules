rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function activeUser() {
      return signedIn()
        && profile().data.active == true
        && (
          !profile().data.keys().hasAny(["approvalStatus"])
          || profile().data.approvalStatus == "approved"
        );
    }

    function role() {
      return activeUser() ? profile().data.role : null;
    }

    function organizationId() {
      return activeUser() ? profile().data.organizationId : null;
    }

    function isMainAdmin() {
      return role() in ["owner", "admin", "dispatcher"];
    }

    function isMainCompanyAdmin() {
      return isMainAdmin() && organizationId() == "main";
    }

    function isSubcontractAdmin() {
      return role() == "subcontract_admin";
    }

    function canManageListOption(orgId, data) {
      return isMainCompanyAdmin()
        || (
          isSubcontractAdmin()
          && organizationId() == orgId
          && data.organizationId == orgId
        );
    }

    function sameOrganization(data) {
      return activeUser()
        && organizationId() != null
        && data.organizationId == organizationId();
    }

    function isAssignedDriver(jobId) {
      return activeUser()
        && get(/databases/$(database)/documents/today_jobs/$(jobId)).data.assignedDriverUid == request.auth.uid;
    }

    function activeTrackedJob(jobId) {
      let job = get(/databases/$(database)/documents/today_jobs/$(jobId)).data;
      return job.trackingEnabled == true
        && !(job.status in ["completed", "cancelled"]);
    }

    function validCoordinates(data) {
      return data.lat is number
        && data.lng is number
        && data.lat >= -90
        && data.lat <= 90
        && data.lng >= -180
        && data.lng <= 180;
    }

    function validCurrentLocation(data) {
      return validCoordinates(data)
        && data.speed is number
        && data.speed >= 0
        && data.speed <= 250
        && data.heading is number
        && data.heading >= 0
        && data.heading <= 360
        && data.accuracy is number
        && data.accuracy >= 0
        && data.accuracy <= 5000
        && data.updatedAt is string;
    }

    function validLocationPoint(data) {
      return validCoordinates(data)
        && data.speed is number
        && data.speed >= 0
        && data.speed <= 250
        && data.heading is number
        && data.heading >= 0
        && data.heading <= 360
        && data.accuracy is number
        && data.accuracy >= 0
        && data.accuracy <= 5000
        && data.timestamp is timestamp
        && data.source in ["gps", "background", "offline_sync"];
    }

    function canReadJob(data) {
      return isMainAdmin() || sameOrganization(data) || data.get("assignedDriverUid", "") == request.auth.uid
        || (role() == "customer"
          && profile().data.customerId is string
          && profile().data.customerId.size() > 0
          && data.customerId == profile().data.customerId);
    }

    // driver_expenses: job claims or independent vehicle costs. Money is in THB.
    function validExpenseReceipt(path, data) {
      return path is string
        && path.matches('driver_expenses/' + data.jobId + '/' + data.driverUid + '/[^/]+');
    }

    function validDriverExpense(data) {
      return data.keys().hasAll([
          "jobId", "workOrder", "organizationId", "driverUid", "driverName",
          "completedMonth", "amount", "note", "receiptPaths", "status",
          "reviewNote", "createdAt", "updatedAt"
        ])
        && data.keys().hasOnly([
          "jobId", "workOrder", "organizationId", "driverUid", "driverName",
          "completedMonth", "amount", "note", "receiptPaths", "status",
          "reviewNote", "createdAt", "updatedAt", "reviewedByUid", "reviewedByName", "reviewedAt",
          "expenseKind", "category", "expenseDate", "vehiclePlate"
        ])
        && data.jobId is string && data.jobId.size() > 0
        && data.workOrder is string && data.workOrder.size() > 0 && data.workOrder.size() <= 80
        && data.organizationId is string && data.organizationId.size() > 0
        && data.driverUid is string && data.driverUid.size() > 0
        && data.driverName is string && data.driverName.size() <= 160
        && data.completedMonth is string && data.completedMonth.matches('[0-9]{4}-[0-9]{2}')
        && data.amount is number && data.amount > 0 && data.amount <= 1000000
        && data.note is string && data.note.size() <= 500
        && data.receiptPaths is list && data.receiptPaths.size() >= 1 && data.receiptPaths.size() <= 5
        && validExpenseReceipt(data.receiptPaths[0], data)
        && (data.receiptPaths.size() < 2 || validExpenseReceipt(data.receiptPaths[1], data))
        && (data.receiptPaths.size() < 3 || validExpenseReceipt(data.receiptPaths[2], data))
        && (data.receiptPaths.size() < 4 || validExpenseReceipt(data.receiptPaths[3], data))
        && (data.receiptPaths.size() < 5 || validExpenseReceipt(data.receiptPaths[4], data))
        && data.status in ["pending", "approved", "rejected", "paid"]
        && data.reviewNote is string && data.reviewNote.size() <= 500
        && (!data.keys().hasAny(["reviewedByUid"]) || data.reviewedByUid is string)
        && (!data.keys().hasAny(["reviewedByName"]) || data.reviewedByName is string)
        && (!data.keys().hasAny(["reviewedAt"]) || data.reviewedAt is timestamp)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function completedExpenseJob(data) {
      let job = get(/databases/$(database)/documents/today_jobs/$(data.jobId)).data;
      return job.status == "completed"
        && job.assignedDriverUid == data.driverUid
        && (
          (job.keys().hasAny(["organizationId"]) && job.organizationId == data.organizationId)
          || (!job.keys().hasAny(["organizationId"]) && data.organizationId == "main")
        )
        && job.workOrder == data.workOrder;
    }

    function validOtherExpense(data) {
      return data.keys().hasAll(["expenseKind", "category", "expenseDate", "vehiclePlate"])
        && data.expenseKind == "other"
        && data.jobId.matches('other_[a-f0-9-]{36}')
        && data.workOrder == "ค่าใช้จ่ายอื่น"
        && data.category in ["repair", "equipment", "wash", "other"]
        && data.expenseDate is string && data.expenseDate.matches(data.completedMonth + '-[0-9]{2}')
        && data.vehiclePlate is string && data.vehiclePlate.size() <= 40;
    }

    function validJobExpense(data) {
      return !data.keys().hasAny(["expenseKind", "category", "expenseDate", "vehiclePlate"])
        && completedExpenseJob(data);
    }

    function validProfilePhoto(data) {
      return !data.keys().hasAny(["photoURL"])
        || data.photoURL == ""
        || data.photoURL.matches('https://(lh3[.]googleusercontent[.]com|firebasestorage[.]googleapis[.]com)/.*');
    }

    function validPersonalProfile(data) {
      return (
          !data.keys().hasAny(["phone"])
          || data.phone == ""
          || data.phone.matches('[0-9]{3}-[0-9]{3}-[0-9]{4}')
        )
        && (
          !data.keys().hasAny(["licenseType"])
          || data.licenseType == ""
          || data.licenseType in ["บ.1", "บ.2", "ท.1", "ท.2", "ท.3", "ท.4"]
        );
    }

    match /users/{uid} {
      allow read: if (signedIn() && uid == request.auth.uid)
        || (
          activeUser() && (
            isMainAdmin()
            || (isSubcontractAdmin() && sameOrganization(resource.data))
          )
        );

      allow create: if signedIn()
        && uid == request.auth.uid
        && request.resource.data.role == "driver"
        && request.resource.data.active == false
        && request.resource.data.approvalStatus == "pending"
        && request.resource.data.organizationId == null
        && request.resource.data.authProvider == "google.com"
        && validProfilePhoto(request.resource.data);

      allow update: if isMainAdmin()
        || (
          signedIn()
          && uid == request.auth.uid
          && resource.data.active == false
          && resource.data.approvalStatus == "pending"
          && !resource.data.keys().hasAny(["accessRequestSubmittedAt"])
          && validProfilePhoto(request.resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "displayName", "photoURL", "googlePhotoURL", "updatedAt"
          ])
        )
        || (
          signedIn()
          && uid == request.auth.uid
          && resource.data.active == false
          && resource.data.approvalStatus == "pending"
          && !resource.data.keys().hasAny(["accessRequestSubmittedAt"])
          && request.resource.data.accessRequestSubmittedAt == request.time
          && request.resource.data.title in ["นาย", "นาง", "นางสาว"]
          && request.resource.data.firstName is string
          && request.resource.data.firstName.size() > 0
          && request.resource.data.firstName.size() <= 50
          && request.resource.data.lastName is string
          && request.resource.data.lastName.size() > 0
          && request.resource.data.lastName.size() <= 50
          && request.resource.data.accessRequestMessage is string
          && request.resource.data.accessRequestMessage.size() > 0
          && request.resource.data.accessRequestMessage.size() <= 500
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "title", "firstName", "lastName", "fullName", "displayName",
            "accessRequestName", "accessRequestMessage", "accessRequestSubmittedAt", "updatedAt"
          ])
        )
        || (
          activeUser()
          && uid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.approvalStatus == resource.data.approvalStatus
          && validProfilePhoto(request.resource.data)
          && validPersonalProfile(request.resource.data)
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "title", "firstName", "lastName", "fullName", "displayName", "phone",
            "photoURL", "googlePhotoURL", "profilePhotoPath",
            "licenseNumber", "licenseType", "licenseExpiry",
            "idCardFrontPath", "idCardFrontFileName",
            "driverLicenseFrontPath", "driverLicenseFrontFileName",
            "fcmToken", "updatedAt"
          ])
        );
      allow delete: if isMainAdmin();
    }

    match /organizations/{orgId} {
      allow read: if isMainCompanyAdmin() || (activeUser() && orgId == organizationId());
      allow create, update: if isMainCompanyAdmin();
      allow delete: if false;
    }

    match /organizations/{orgId}/list_options/{itemId} {
      allow read: if activeUser() && (isMainAdmin() || orgId == organizationId()
        || (role() == "customer" && orgId == "main" && resource.data.field == "vehicle_type"));
      allow create: if request.resource.data.organizationId == orgId
        && canManageListOption(orgId, request.resource.data);
      allow update: if resource.data.organizationId == orgId
        && request.resource.data.organizationId == orgId
        && request.resource.data.field == resource.data.field
        && canManageListOption(orgId, resource.data);
      allow delete: if resource.data.organizationId == orgId
        && canManageListOption(orgId, resource.data);
    }

    function validContact(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 160
        && data.phone is string && data.phone.size() >= 7 && data.phone.size() <= 40
        && data.company is string && data.company.size() <= 200
        && data.location is string && data.location.size() <= 200
        && data.notes is string && data.notes.size() <= 500
        && data.active is bool;
    }

    match /organizations/{orgId}/contacts/{contactId} {
      allow read: if isMainCompanyAdmin() || (isSubcontractAdmin() && orgId == organizationId());
      allow create: if request.resource.data.organizationId == orgId
        && validContact(request.resource.data)
        && canManageListOption(orgId, request.resource.data);
      allow update: if resource.data.organizationId == orgId
        && request.resource.data.organizationId == orgId
        && validContact(request.resource.data)
        && canManageListOption(orgId, resource.data);
      allow delete: if false;
    }

    match /organizations/{orgId}/locations/{locationId} {
      allow read: if activeUser() && (isMainAdmin() || orgId == organizationId());
      allow create: if request.resource.data.organizationId == orgId
        && canManageListOption(orgId, request.resource.data);
      allow update: if resource.data.organizationId == orgId
        && request.resource.data.organizationId == orgId
        && canManageListOption(orgId, resource.data);
      allow delete: if false;
    }

    match /customers/{customerId}/locations/{locationId} {
      allow read: if isMainCompanyAdmin()
        || (activeUser() && role() == "customer" && profile().data.customerId == customerId);
      allow write: if false;
    }

    match /customers/{customerId}/contacts/{contactId} {
      allow read: if isMainCompanyAdmin()
        || (activeUser() && role() == "customer" && profile().data.customerId == customerId);
      allow write: if false;
    }

    match /customers/{customerId}/cargo_types/{itemId} {
      allow read: if isMainCompanyAdmin()
        || (activeUser() && role() == "customer" && profile().data.customerId == customerId);
      allow write: if false;
    }

    match /customer_job_requests/{requestId} {
      allow read: if isMainCompanyAdmin()
        || (activeUser() && role() == "customer"
          && resource.data.customerId == profile().data.customerId);
      allow create, delete: if false;
      allow update: if isMainCompanyAdmin()
        && resource.data.status == "pending"
        && request.resource.data.status == "accepted"
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.jobId is string
        && request.resource.data.jobId.size() > 0
        && request.resource.data.workOrder is string
        && request.resource.data.workOrder.size() > 0
        && request.resource.data.decidedByUid == request.auth.uid
        && request.resource.data.decidedAt == request.time
        && getAfter(/databases/$(database)/documents/today_jobs/$(request.resource.data.jobId)).data.sourceRequestId == requestId
        && getAfter(/databases/$(database)/documents/today_jobs/$(request.resource.data.jobId)).data.customerId == resource.data.customerId
        && getAfter(/databases/$(database)/documents/today_jobs/$(request.resource.data.jobId)).data.workOrder == request.resource.data.workOrder
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "jobId", "workOrder", "decidedByUid", "decidedAt"
        ]);
    }

    match /job_counters/{dateKey} {
      allow read: if isMainAdmin() || isSubcontractAdmin();
      allow create: if (isMainAdmin() || isSubcontractAdmin())
        && request.resource.data.keys().hasOnly(["dateKey", "lastSequence", "updatedAt"])
        && request.resource.data.dateKey == dateKey
        && request.resource.data.lastSequence is int
        && request.resource.data.lastSequence >= 1
        && (isMainCompanyAdmin() && request.resource.data.lastSequence <= 200
          || isSubcontractAdmin() && request.resource.data.lastSequence == 1)
        && request.resource.data.updatedAt == request.time;
      allow update: if (isMainAdmin() || isSubcontractAdmin())
        && resource.data.dateKey == dateKey
        && request.resource.data.dateKey == dateKey
        && request.resource.data.lastSequence is int
        && request.resource.data.lastSequence > resource.data.lastSequence
        && (isMainCompanyAdmin() && request.resource.data.lastSequence <= resource.data.lastSequence + 200
          || isSubcontractAdmin() && request.resource.data.lastSequence == resource.data.lastSequence + 1)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(["lastSequence", "updatedAt"]);
      allow delete: if false;
    }

    match /today_jobs/{jobId} {
      allow read: if activeUser() && canReadJob(resource.data);
      allow create: if isMainCompanyAdmin()
        && (
          (request.resource.data.historical == true
            && request.resource.data.organizationId == "main"
            && request.resource.data.originOrganizationId == "main"
            && request.resource.data.status == "completed"
            && request.resource.data.trackingStatus == "completed"
            && request.resource.data.trackingEnabled == false
            && !request.resource.data.keys().hasAny(["assignedDriverUid", "trackingShareToken"])
            && request.resource.data.createdByUid == request.auth.uid
            && request.resource.data.createdAt == request.time
            && request.resource.data.completedAt is timestamp
            && request.resource.data.completedAt <= request.time
            && request.resource.data.workOrder.matches('JN-[0-9]{8}[0-9]{3,}PE')
            && request.resource.data.historicalEvidence.pickup is list
            && request.resource.data.historicalEvidence.delivery is list
            && request.resource.data.historicalEvidence.pickup.size() >= 1
            && request.resource.data.historicalEvidence.pickup.size() <= 10
            && request.resource.data.historicalEvidence.delivery.size() >= 1
            && request.resource.data.historicalEvidence.delivery.size() <= 10
            && request.resource.data.historicalEvidence.document is list
            && request.resource.data.historicalEvidence.document.size() <= 10
            && request.resource.data.historicalEvidence.expense is list
            && request.resource.data.historicalEvidence.expense.size() <= 10)
          ||
          (request.resource.data.organizationId == "main"
            && request.resource.data.status == "assigned"
            && request.resource.data.get("originOrganizationId", "main") == "main")
          || (request.resource.data.organizationId != "main"
            && request.resource.data.originOrganizationId == "main"
            && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.type == "subcontract"
            && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.active == true
            && get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.get("deleted", false) == false
            && request.resource.data.status == "pending_subcontract"
            && !request.resource.data.keys().hasAny(["assignedDriverUid"]))
        );
      allow delete: if isMainCompanyAdmin();
      allow update: if isMainAdmin()
        || (
          isSubcontractAdmin()
          && sameOrganization(resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.get("originOrganizationId", "") == resource.data.get("originOrganizationId", "")
          && (
            (resource.data.status == "pending_subcontract"
              && resource.data.originOrganizationId == "main"
              && request.resource.data.status == "subcontract_accepted"
              && request.resource.data.acceptedByUid == request.auth.uid
              && request.resource.data.acceptedAt == request.time
              && request.resource.data.updatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "acceptedByUid", "acceptedAt", "updatedAt"]))
            || (resource.data.status == "subcontract_accepted"
              && resource.data.originOrganizationId == "main"
              && request.resource.data.status == "assigned"
              && request.resource.data.updatedAt == request.time
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "driverId", "vehicleId", "vehiclePlate", "assignedDriverUid", "driverName", "driverPhone", "updatedAt"])
              && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.organizationId == organizationId()
              && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.status in ["available", "assigned"]
              && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.userUid == request.resource.data.assignedDriverUid
              && get(/databases/$(database)/documents/drivers/$(request.resource.data.driverId)).data.get("assignedVehicleId", "") in ["", request.resource.data.vehicleId]
              && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.organizationId == organizationId()
              && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.status in ["available", "assigned"]
              && get(/databases/$(database)/documents/vehicles/$(request.resource.data.vehicleId)).data.plate == request.resource.data.vehiclePlate
              && get(/databases/$(database)/documents/users/$(request.resource.data.assignedDriverUid)).data.organizationId == organizationId()
              && get(/databases/$(database)/documents/users/$(request.resource.data.assignedDriverUid)).data.active == true
              && get(/databases/$(database)/documents/users/$(request.resource.data.assignedDriverUid)).data.approvalStatus == "approved")
            || (!(resource.data.status in ["pending_subcontract", "subcontract_accepted"])
              && !(request.resource.data.status in ["pending_subcontract", "subcontract_accepted"])
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                "workOrder", "customer", "customerId", "jobDate", "cargoType", "vehicleType", "tripCount", "returnTrip",
                "pickupLocation", "pickupPlace", "pickupDate", "pickupTime", "pickupContactId", "pickupContact", "pickupContactPhone", "pickupContactNotes",
                "deliveryLocation", "deliveryPlace", "deliveryDate", "deliveryTime", "deliveryContactId", "deliveryContact", "deliveryContactPhone", "deliveryContactNotes",
                "eta", "notes", "driverId", "vehicleId", "vehiclePlate", "assignedDriverUid", "driverName", "driverPhone", "carrierName", "trackingShareToken"
              ])
              && (resource.data.get("originOrganizationId", "") != "main"
                || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["deletedAt", "deletedByUid", "deletedByName"])
                  && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"])
                    || (resource.data.status == "problem"
                      && request.resource.data.status == resource.data.issuePreviousStatus)))))
          )
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(["customerId"])
            || (
              request.resource.data.diff(resource.data).affectedKeys().hasAll(["customer", "customerId"])
              && !request.resource.data.keys().hasAny(["customerId"])
            )
          )
        )
        || (
          isAssignedDriver(jobId)
          && request.resource.data.assignedDriverUid == resource.data.assignedDriverUid
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "trackingEnabled", "trackingStartedAt", "trackingEndedAt",
            "currentLocation", "trackingStatus", "updatedAt", "arrivedDeliveryAt", "completedAt",
            "issuePreviousStatus", "lastIssue", "alerts", "pickupProof", "deliveryProof",
            "activeLeg", "returnPickupProof", "returnDeliveryProof", "returnArrivedDeliveryAt",
            "handoverDocumentPhotoPaths"
          ])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["handoverDocumentPhotoPaths"]) || (
            (resource.data.status in ["ready_to_close", "completed"] || (resource.data.status == "problem" && resource.data.get("issuePreviousStatus", "") == "ready_to_close"))
            && request.resource.data.handoverDocumentPhotoPaths is list
            && request.resource.data.handoverDocumentPhotoPaths.size() >= 1
            && request.resource.data.handoverDocumentPhotoPaths.size() <= 10
            && request.resource.data.handoverDocumentPhotoPaths.size() > resource.data.get("handoverDocumentPhotoPaths", []).size()
            && request.resource.data.handoverDocumentPhotoPaths.hasAll(resource.data.get("handoverDocumentPhotoPaths", []))
          ))
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["activeLeg"]) || (
            resource.data.returnTrip is map
            && resource.data.activeLeg == 1
            && request.resource.data.activeLeg == 2
            && resource.data.status == "ready_to_close"
            && request.resource.data.status == "to_pickup"
            && resource.data.pickupProof is map
            && resource.data.deliveryProof is map
          ))
          && (
            !request.resource.data.diff(resource.data).changedKeys().hasAny(["currentLocation"])
            || validCurrentLocation(request.resource.data.currentLocation)
          )
          && (!(request.resource.data.status == "to_delivery" && resource.data.status != "to_delivery") || (
            (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnPickupProof : request.resource.data.pickupProof) is map
            && (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnPickupProof : request.resource.data.pickupProof).photoPaths is list
            && (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnPickupProof : request.resource.data.pickupProof).photoPaths.size() >= 1
            && (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnPickupProof : request.resource.data.pickupProof).signaturePath is string
            && (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnPickupProof : request.resource.data.pickupProof).signerName is string
          ))
          && (!(request.resource.data.status == "ready_to_close" && resource.data.status != "ready_to_close") || (
            (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnDeliveryProof : request.resource.data.deliveryProof) is map
            && (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnDeliveryProof : request.resource.data.deliveryProof).photoPaths is list
            && (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnDeliveryProof : request.resource.data.deliveryProof).photoPaths.size() >= 1
            && (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnDeliveryProof : request.resource.data.deliveryProof).signaturePath is string
            && (resource.data.keys().hasAny(["activeLeg"]) && resource.data.activeLeg == 2 ? request.resource.data.returnDeliveryProof : request.resource.data.deliveryProof).signerName is string
          ))
          && (!(request.resource.data.status == "completed" && resource.data.status != "completed") || (
            request.resource.data.pickupProof is map
            && request.resource.data.deliveryProof is map
            && (!request.resource.data.keys().hasAny(["returnTrip"]) || (
              request.resource.data.activeLeg == 2
              && request.resource.data.returnPickupProof is map
              && request.resource.data.returnDeliveryProof is map
            ))
          ))
        );
    }

    match /driver_expenses/{expenseId} {
      // A driver must be able to read their deterministic ID before its first create.
      allow get: if activeUser() && (
        expenseId.matches('.*_' + request.auth.uid)
        || isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data))
      );
      allow list: if activeUser() && (
        resource.data.driverUid == request.auth.uid
        || isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data))
      );
      allow create: if activeUser()
        && role() != "customer"
        && expenseId == request.resource.data.jobId + "_" + request.auth.uid
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.organizationId == organizationId()
        && request.resource.data.status == "pending"
        && request.resource.data.reviewNote == ""
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && validDriverExpense(request.resource.data)
        && (validJobExpense(request.resource.data) || validOtherExpense(request.resource.data));
      allow update: if activeUser()
        && validDriverExpense(request.resource.data)
        && request.resource.data.jobId == resource.data.jobId
        && request.resource.data.driverUid == resource.data.driverUid
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            resource.data.driverUid == request.auth.uid
            && resource.data.status in ["pending", "approved", "rejected", "paid"]
            && request.resource.data.status == "pending"
            && request.resource.data.reviewNote == ""
            && !request.resource.data.keys().hasAny(["reviewedByUid", "reviewedByName", "reviewedAt"])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "amount", "note", "receiptPaths", "status", "reviewNote", "updatedAt",
              "category", "expenseDate", "vehiclePlate", "completedMonth",
              "reviewedByUid", "reviewedByName", "reviewedAt"
            ])
            && (
              (resource.data.keys().hasAny(["expenseKind"]) && validOtherExpense(request.resource.data))
              || (request.resource.data.completedMonth == resource.data.completedMonth && validJobExpense(request.resource.data))
            )
          )
          || (
            (isMainAdmin() || (isSubcontractAdmin() && sameOrganization(resource.data)))
            && (
              resource.data.status == "pending" && request.resource.data.status in ["approved", "rejected"]
            )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "reviewNote", "reviewedByUid", "reviewedByName", "reviewedAt", "updatedAt"
            ])
            && request.resource.data.reviewedByUid == request.auth.uid
            && request.resource.data.reviewedAt == request.time
          )
        );
      allow delete: if activeUser()
        && role() != "customer"
        && resource.data.driverUid == request.auth.uid
        && resource.data.organizationId == organizationId()
        && expenseId == resource.data.jobId + "_" + request.auth.uid
        && resource.data.status in ["pending", "rejected"];
    }

    match /jobs/{jobId} {
      allow read: if activeUser() && role() != "customer" && canReadJob(resource.data);
      allow write: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
    }

    match /job_locations/{jobId}/points/{pointId} {
      allow read: if isMainAdmin()
        || isAssignedDriver(jobId)
        || sameOrganization(get(/databases/$(database)/documents/today_jobs/$(jobId)).data);
      allow create: if isAssignedDriver(jobId)
        && activeTrackedJob(jobId)
        && request.resource.data.driverUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          "driverUid", "lat", "lng", "speed", "heading", "accuracy",
          "batteryLevel", "timestamp", "source", "leg"
        ])
        && (!request.resource.data.keys().hasAny(["leg"]) || request.resource.data.leg in [1, 2])
        && validLocationPoint(request.resource.data);
      allow update, delete: if false;
    }

    match /job_events/{eventId} {
      allow read: if activeUser() && role() != "customer"
        && canReadJob(get(/databases/$(database)/documents/today_jobs/$(resource.data.jobId)).data);
      allow create: if activeUser() && role() != "customer"
        && canReadJob(get(/databases/$(database)/documents/today_jobs/$(request.resource.data.jobId)).data);
      allow update, delete: if isMainAdmin();
    }

    match /driver_live_status/{driverUid} {
      allow read: if isMainAdmin()
        || (role() != "customer" && driverUid == request.auth.uid)
        || (isSubcontractAdmin() && sameOrganization(resource.data));
      allow write: if (role() != "customer" && driverUid == request.auth.uid)
        || isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
    }

    match /push_subscriptions/{uid}/devices/{deviceId} {
      allow read, delete: if activeUser() && uid == request.auth.uid;
      allow create: if activeUser()
        && uid == request.auth.uid
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() > 0
        && request.resource.data.endpoint.size() <= 2048
        && request.resource.data.keys is map
        && request.resource.data.keys.p256dh is string
        && request.resource.data.keys.auth is string
        && request.resource.data.keys().hasOnly([
          "recipientUid", "organizationId", "endpoint", "expirationTime",
          "keys", "userAgent", "standalone", "updatedAt"
        ]);
      allow update: if activeUser()
        && uid == request.auth.uid
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.endpoint is string
        && request.resource.data.endpoint.size() > 0
        && request.resource.data.endpoint.size() <= 2048
        && request.resource.data.keys is map
        && request.resource.data.keys.p256dh is string
        && request.resource.data.keys.auth is string
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          "recipientUid", "organizationId", "endpoint", "expirationTime",
          "keys", "userAgent", "standalone", "updatedAt"
        ]);
    }

    match /proof_of_delivery/{podId} {
      allow read: if activeUser() && role() != "customer"
        && canReadJob(get(/databases/$(database)/documents/today_jobs/$(resource.data.jobId)).data);
      allow create: if activeUser() && role() != "customer"
        && request.resource.data.uploadedByUid == request.auth.uid
        && canReadJob(get(/databases/$(database)/documents/today_jobs/$(request.resource.data.jobId)).data);
      allow update, delete: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data));
    }

    match /tracking_share_links/{linkId} {
      allow get: if isMainCompanyAdmin()
        || (resource.data.enabled == true && request.time < resource.data.expiresAt);
      allow list: if isMainCompanyAdmin()
        || (activeUser() && (sameOrganization(resource.data) || isAssignedDriver(resource.data.jobId)));
      allow create: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
      allow update, delete: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data))
        || (
          isAssignedDriver(resource.data.jobId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.diff(resource.data).changedKeys().hasOnly([
            "statusLabel", "eta", "lastUpdatedAt", "currentLocation", "updatedAt"
          ])
        );
    }

    match /vehicle_share_links/{linkId} {
      allow get: if isMainCompanyAdmin()
        || (resource.data.enabled == true && request.time < resource.data.expiresAt);
      allow list: if isMainCompanyAdmin()
        || (activeUser() && sameOrganization(resource.data));
      allow create: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
      allow update, delete: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data));
    }

    match /driver_share_links/{linkId} {
      allow get: if isMainCompanyAdmin()
        || (resource.data.enabled == true && request.time < resource.data.expiresAt);
      allow list: if isMainCompanyAdmin()
        || (activeUser() && sameOrganization(resource.data));
      allow create: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
      allow update, delete: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data));
    }

    match /vehicles/{docId} {
      allow get: if isMainCompanyAdmin()
        || (isSubcontractAdmin() && resource == null && docId.matches(organizationId() + '--.+'))
        || sameOrganization(resource.data);
      allow list: if isMainCompanyAdmin() || sameOrganization(resource.data);
      allow create: if isMainCompanyAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
      allow update: if isMainCompanyAdmin()
        || (
          isSubcontractAdmin()
          && sameOrganization(resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
        );
      allow delete: if isMainCompanyAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data));
    }

    match /drivers/{docId} {
      allow get: if isMainCompanyAdmin()
        || (isSubcontractAdmin() && resource == null && docId.matches(organizationId() + '--.+'))
        || sameOrganization(resource.data);
      allow list: if isMainCompanyAdmin() || sameOrganization(resource.data);
      allow create: if isMainCompanyAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
      allow update: if isMainCompanyAdmin()
        || (
          isSubcontractAdmin()
          && sameOrganization(resource.data)
          && request.resource.data.organizationId == resource.data.organizationId
        );
      allow delete: if isMainCompanyAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data));
    }

    match /customer_names/{nameId} {
      allow read, write: if isMainCompanyAdmin();
    }

    match /customers/{docId} {
      allow read: if isMainAdmin() || sameOrganization(resource.data);
      allow write: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
    }

    match /locations/{docId} {
      allow read: if activeUser() && role() != "customer";
      allow write: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(request.resource.data));
    }

    match /notifications/{docId} {
      allow read: if activeUser() && (
        resource.data.recipientUid == request.auth.uid
        || isMainAdmin()
        || sameOrganization(resource.data)
      );
      allow create: if activeUser() && role() != "customer";
      allow update, delete: if isMainAdmin()
        || (isSubcontractAdmin() && sameOrganization(resource.data));
    }
  }
}
